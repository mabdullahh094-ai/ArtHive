# ArtHive Backend Environment Configuration
# Copy this file to /var/www/arthive/arthive-backend/.env on your server
# Fill in your actual values

# ==================== Server Configuration ====================
NODE_ENV=production
PORT=3001

# ==================== Database Configuration ====================
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arthive_db
DB_USER=arthive_user
DB_PASSWORD=your_secure_password_here

# ==================== Authentication ====================
# JWT Secret - Use a strong random string (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_change_this

# ==================== CORS Configuration ====================
# Allow requests from your frontend URL
CORS_ORIGIN=http://your-server-ip:3000

# ==================== Payment Integration ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== Email Configuration ====================
# Choose one: 'gmail', 'sendgrid', or 'smtp'
EMAIL_SERVICE=sendgrid

# For SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# For Gmail or SMTP
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@arthive.com

# ==================== ML Models ====================
# Path to trained models (should be /var/www/arthive/models on production)
MODEL_DIR=/var/www/arthive/models

# ==================== File Upload ====================
# Max file upload size
MAX_FILE_SIZE=10485760

# ==================== Logging ====================
LOG_LEVEL=info
