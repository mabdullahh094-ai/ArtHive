[Unit]
Description=ArtHive Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/arthive/arthive-backend
Environment="NODE_ENV=production"
Environment="PORT=3001"
EnvironmentFile=/var/www/arthive/arthive-backend/.env
ExecStart=/usr/bin/node /var/www/arthive/arthive-backend/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arthive-backend

[Install]
WantedBy=multi-user.target
